{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EngagementScope",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope_id", "authorized", "starts_at", "ends_at", "targets", "allowed_techniques", "roe_ref"],
  "properties": {
    "scope_id": { "type": "string", "minLength": 1 },
    "authorized": { "const": true },
    "starts_at": { "type": "string", "format": "date-time" },
    "ends_at": { "type": "string", "format": "date-time" },
    "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^fixture://" } },
    "allowed_techniques": { "type": "array", "items": { "type": "string" } },
    "roe_ref": { "type": "string", "minLength": 1 }
  }
}
